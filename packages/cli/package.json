{
  "name": "swcrypts",
  "description": "Encrypt static sites.",
  "version": "0.0.2",
  "type": "module",
  "module": "src/index.ts",
  "private": true,
  "devDependencies": {
    "@types/bun": "catalog:",
    "bunli": "^0.9.1",
    "ts-json-schema-generator": "^2.9.0"
  },
  "dependencies": {
    "@bunli/core": "^0.9.1",
    "@swcrypts/core": "workspace:",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "bun run build:schema && bunli build",
    "build:schema": "ts-json-schema-generator --path config.ts --type SwCryptsConfig --jsDoc extended --no-type-check -o config.schema.json && prettier --write config.schema.json",
    "test": "bun test"
  }
}
