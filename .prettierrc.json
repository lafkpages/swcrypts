{
  "$schema": "https://schemastore.org/prettierrc.json",

  "plugins": ["prettier-plugin-astro", "@ianvs/prettier-plugin-sort-imports"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ],

  "printWidth": 100,

  "importOrderTypeScriptVersion": "7.0.2",
  "importOrderParserPlugins": ["typescript"],
  "importOrder": [
    "<TYPES>",
    "<TYPES>^[.]",
    "",
    "^bun:?$",
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@?swcrypts/",
    "^[.]"
  ]
}
